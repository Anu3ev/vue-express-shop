{
  "name": "vue-express-shop",
  "version": "0.1.0",
  "private": true,
  "description": "Educational Vue storefront with an Express catalog API and a browser-local demo cart",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "vite build",
    "prestart": "npm run build",
    "start": "node server.js",
    "dev": "concurrently -k -n api,web \"node --watch server.js\" \"vite\"",
    "pretest": "npm run build",
    "test": "node --test test/server.test.cjs && vitest run",
    "test:e2e": "playwright test",
    "check": "node --check server.js && node --check api/catalog.js && npm test"
  },
  "author": "Alexander Anufriev",
  "license": "MIT",
  "dependencies": {
    "express": "5.2.1",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.8",
    "concurrently": "9.2.1",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  }
}
